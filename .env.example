# Telegram Configuration (Required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional Reddit OAuth2 Configuration (Increases rate limit from 10 to 100 req/min)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:constantine-referral-monitor:v2.0 (by /u/your_username)

# Poller & Storage Settings
POLL_INTERVAL_SECONDS=15
DB_PATH=referrals.db

# Comma-separated list of JSON or RSS/text endpoints to monitor
TARGET_SOURCES=https://old.reddit.com/r/ClaudeAI/new/.rss?limit=25,https://old.reddit.com/r/ClaudeAI/comments/.rss?limit=50,https://old.reddit.com/r/referrals/new/.rss?limit=25,https://old.reddit.com/r/referralcodes/new/.rss?limit=25,https://hn.algolia.com/api/v1/search_by_date?query=claude.ai%2Freferral%20OR%20claude.ai%2Finvite
